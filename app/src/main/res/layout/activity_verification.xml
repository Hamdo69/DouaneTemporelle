<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_verification_root_kh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F0E6"
    tools:context=".VerificationActivity">

    <LinearLayout
        android:id="@+id/layout_passport_kh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_passport_kh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:contentDescription="Image du passeport temporel"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <RelativeLayout
            android:id="@+id/layout_info_kh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_passport_title_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TEMPORAL PASSPORT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#6B3F2A"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/txt_nom_label_kh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOM DU VOYAGEUR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#777777"
                android:layout_below="@id/txt_passport_title_kh" />

            <TextView
                android:id="@+id/txt_nom_value_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom du voyageur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_below="@id/txt_nom_label_kh"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txt_age_label_kh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGE À DESTINATION"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#777777"
                android:layout_below="@id/txt_nom_value_kh"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/txt_age_value_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00 ans"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_below="@id/txt_age_label_kh"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txt_motif_label_kh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTIF DU VOYAGE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#777777"
                android:layout_below="@id/txt_age_value_kh"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/txt_motif_value_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motif"
                android:textSize="16sp"
                android:textColor="#222222"
                android:layout_below="@id/txt_motif_label_kh"
                android:layout_marginTop="4dp" />

        </RelativeLayout>
    </LinearLayout>

    <!-- el buttons mt3 decision -->
    <Button
        android:id="@+id/btn_approuver_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approuver le saut temporel"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btn_refuser_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refuser (Risque de paradoxe)"
        android:layout_marginTop="8dp" />

</LinearLayout>